# ======================= BACKEND (Render / docker-compose) =======================
# --- Required ---
DATABASE_URL=postgresql://aura:aura@localhost:5432/aura     # Render/Supabase URLs work as-is
GROQ_API_KEY=                                               # https://console.groq.com/keys  (never exposed to the browser)
GROQ_MODEL=openai/gpt-oss-120b                              # check console.groq.com/docs/models; llama-3.3-70b-versatile is retired
GROQ_STT_MODEL=whisper-large-v3                             # speech-to-text (Tamil / Hindi / English)

# --- Security ---
APP_ENV=development                                         # production on Render
ADMIN_API_KEY=                                              # REQUIRED in production; admin is disabled without it
CORS_ORIGINS=http://localhost:3000                          # comma separated; use your exact Vercel URL in production
CORS_ORIGIN_REGEX=                                          # optional, e.g. https://aura-.*\.vercel\.app for preview deploys

# --- Boot behaviour ---
AUTO_CREATE_TABLES=true
AUTO_SEED=false                                             # true = seed the demo hotel when the DB is empty (handy on Render free tier)
DEFAULT_HOTEL_SLUG=aurelia-grand

# --- Voice output (Tamil / Hindi / English neural voices) ---
TTS_PROVIDER=auto                                           # auto | azure | edge | none
AZURE_SPEECH_KEY=                                           # optional, recommended for production reliability
AZURE_SPEECH_REGION=                                        # e.g. centralindia
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# --- Adapters (placeholders for future vendors) ---
AVATAR_PROVIDER=demo
AVATAR_API_KEY=
VOICE_PROVIDER=server
VOICE_API_KEY=

# ======================= FRONTEND (Vercel) - browser-visible only =======================
NEXT_PUBLIC_API_URL=http://localhost:8000                   # your Render URL in production
NEXT_PUBLIC_HOTEL_SLUG=
NEXT_PUBLIC_AVATAR_PROVIDER=demo
NEXT_PUBLIC_VOICE_PROVIDER=server
